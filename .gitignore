# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
venv/
.venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.pyo
*.pyd
*.pyc
*.tmp
*.temp
*.bak
*.orig
*.rej
.pytest_cache/
.hypothesis/
.eggs/
build/
dist/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.mypy_cache/
.ruff_cache/

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
*.log
logs/
local_settings.py
db.sqlite3
db.sqlite3-journal
staticfiles/
media/

# ---------------------------------------------------------------------------
# Environment / secrets
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# ---------------------------------------------------------------------------
# Node / frontend tooling
# ---------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-error.log*

# The compiled Tailwind bundle IS committed so deployments do not require a
# Node toolchain. Remove the following line if you prefer to build in CI.
# static/css/app.css

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# Django migrations (generated per environment; not committed)
# ---------------------------------------------------------------------------
# Every migration module except the package marker is ignored.
**/migrations/*.py
!**/migrations/__init__.py
