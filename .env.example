# ===========================================================================
# Checklist Platform - environment configuration example
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# ===========================================================================

# --- Core ------------------------------------------------------------------
SECRET_KEY=change-me-generate-a-long-random-string
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_DEBUG=True
DJANGO_ENVIRONMENT=development
APP_NAME=Checklist Platform
APP_VERSION=0.1.0
DJANGO_LANGUAGE_CODE=en-us
DJANGO_TIME_ZONE=UTC

# Comma-separated. Use explicit hostnames in production.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated scheme+host origins trusted for CSRF (e.g. https://app.example.com)
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Database --------------------------------------------------------------
# postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://postgres:postgres@localhost:5432/checklist_platform
# Optional dedicated test database (defaults to DATABASE_URL).
TEST_DATABASE_URL=
DB_CONN_MAX_AGE=0
DB_CONN_HEALTH_CHECKS=True
DB_SSL_REQUIRE=False

# --- Microsoft Entra ID / Office 365 (implemented in a later phase) --------
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=
MICROSOFT_GRAPH_SCOPES=

# --- Email (Django 6.1 MAILERS API) ---------------------------------------
# Microsoft 365 SMTP relay example:
#   EMAIL_HOST=smtp.office365.com  EMAIL_PORT=587  EMAIL_USE_TLS=True
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=30
DEFAULT_FROM_EMAIL=no-reply@checklist-platform.local
SERVER_EMAIL=no-reply@checklist-platform.local
EMAIL_SUBJECT_PREFIX=[Checklist Platform]
# Provider seam: DjangoEmailProvider (SMTP) or the future Microsoft 365 provider.
NOTIFICATION_EMAIL_PROVIDER=apps.notifications.providers.django_smtp.DjangoEmailProvider

# --- Storage (S3/Azure Blob in a later phase) ------------------------------
STORAGE_BACKEND=django.core.files.storage.FileSystemStorage
# AWS_STORAGE_BUCKET_NAME=
# AZURE_STORAGE_CONNECTION_STRING=

# --- Security (production) -------------------------------------------------
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=True

# --- API throttling --------------------------------------------------------
API_THROTTLE_ANON=60/min
API_THROTTLE_USER=1000/hour

# --- Logging ---------------------------------------------------------------
DJANGO_LOG_LEVEL=INFO
APP_LOG_LEVEL=INFO
