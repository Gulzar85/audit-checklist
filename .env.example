# ===========================================================================
# Checklist Platform - environment configuration example
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# ===========================================================================

# --- Core ------------------------------------------------------------------
SECRET_KEY=change-me-generate-a-long-random-string
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_DEBUG=True
DJANGO_ENVIRONMENT=development
APP_NAME=Checklist Platform
APP_VERSION=0.1.0
DJANGO_LANGUAGE_CODE=en-us
DJANGO_TIME_ZONE=UTC

# Comma-separated. Use explicit hostnames in production.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated scheme+host origins trusted for CSRF (e.g. https://app.example.com)
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Database --------------------------------------------------------------
# postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://postgres:postgres@localhost:5432/checklist_platform
# Optional dedicated test database (defaults to DATABASE_URL).
TEST_DATABASE_URL=
DB_CONN_MAX_AGE=0
DB_CONN_HEALTH_CHECKS=True
DB_SSL_REQUIRE=False

# --- Microsoft Entra ID / Office 365 ----------------------------------------
# OpenID Connect sign-in (MSAL). All values are required for Entra sign-in; the
# application runs with local passwords when they are absent (dev/test).
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Must exactly match the Redirect URI registered on the Entra app, e.g.
#   http://localhost:8000/auth/microsoft/callback/
MICROSOFT_REDIRECT_URI=
# Optional: where Microsoft returns the browser after a federated sign-out.
MICROSOFT_POST_LOGOUT_REDIRECT_URI=
# Space or comma separated. Identity only - we never request Graph.
MICROSOFT_SCOPES=openid,profile,email
# Optional allow-list of directory (tenant) ids; empty = the configured tenant only.
MICROSOFT_ALLOWED_TENANTS=
# First login of an unknown-but-valid identity: "pending" (await approval) or "active".
AUTH_PROVISIONING_MODE=pending
# Link a first-time Entra identity to an existing local account by email:
# "non_staff" (default, never links a privileged account), "all", or "disabled".
AUTH_EMAIL_LINKING=non_staff
# Local email/password fallback login (development/test only). MUST be False in production:
# config.settings.production refuses to start otherwise.
ENABLE_PASSWORD_LOGIN=True
# Sign the browser out of Microsoft too on logout (off by default).
MICROSOFT_FEDERATED_LOGOUT=False
# Failed sign-in attempts allowed per client address before a temporary block.
AUTH_THROTTLE_MAX_ATTEMPTS=10
# Length of the throttle window, in seconds.
AUTH_THROTTLE_WINDOW_SECONDS=300
# Number of reverse proxies in front of the app. The throttle then trusts that many hops of
# X-Forwarded-For counted from the right. 0 = trust none (REMOTE_ADDR only).
TRUSTED_PROXY_COUNT=0
# Session lifetime in seconds: a sign-in never outlives the absolute limit (default 8 h) and
# ends after the idle limit without requests (default 30 min; 0 disables the idle limit).
SESSION_ABSOLUTE_TIMEOUT_SECONDS=28800
SESSION_IDLE_TIMEOUT_SECONDS=1800

# --- Email (Django 6.1 MAILERS API) ---------------------------------------
# Microsoft 365 SMTP relay example:
#   EMAIL_HOST=smtp.office365.com  EMAIL_PORT=587  EMAIL_USE_TLS=True
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=30
DEFAULT_FROM_EMAIL=no-reply@checklist-platform.local
SERVER_EMAIL=no-reply@checklist-platform.local
EMAIL_SUBJECT_PREFIX=[Checklist Platform]
# Provider seam: DjangoEmailProvider (SMTP) or the future Microsoft 365 provider.
NOTIFICATION_EMAIL_PROVIDER=apps.notifications.providers.django_smtp.DjangoEmailProvider

# --- Storage (S3/Azure Blob in a later phase) ------------------------------
STORAGE_BACKEND=django.core.files.storage.FileSystemStorage
# AWS_STORAGE_BUCKET_NAME=
# AZURE_STORAGE_CONNECTION_STRING=

# --- Security (production) -------------------------------------------------
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=True

# --- API throttling --------------------------------------------------------
API_THROTTLE_ANON=60/min
API_THROTTLE_USER=1000/hour

# --- Logging ---------------------------------------------------------------
DJANGO_LOG_LEVEL=INFO
APP_LOG_LEVEL=INFO

# --- Notifications (Phase 17) ---
# NOTIFICATION_EMAIL_PROVIDER=apps.notifications.providers.microsoft365.Microsoft365EmailProvider
# NOTIFICATION_GRAPH_SENDER=
# NOTIFICATION_DISPATCH_INLINE=True
# NOTIFICATION_MAX_ATTEMPTS=5
# NOTIFICATION_RETENTION_DAYS=180
# NOTIFICATION_BASE_URL=http://localhost:8000
